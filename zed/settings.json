// Zed settings
// https://zed.dev/docs/configuring-zed
{
  "agent": {
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
      "effort": "medium"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "toolbar": {
    "code_actions": true
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": true
    }
  },
  "buffer_font_weight": 400.0,
  "agent_buffer_font_size": 15.0,
  "markdown_preview_font_size": 15.0,
  "agent_ui_font_size": 16.0,
  "auto_install_extensions": {
    "html": true,
    "ruby": true
  },
  "status_bar": {
    "show_active_file": true
  },
  "languages": {
    "Ruby": {
      "tab_size": 2
    }
  },
  "diff_view_style": "unified",
  "git_panel": {
    "file_icons": true,
    "tree_view": true,
    "group_by": "staging"
  },
  "project_panel": {
    "hide_gitignore": false,
    "dock": "left"
  },
  "pane_split_direction_vertical": "right",
  "session": {
    "trust_all_worktrees": true
  },
  "base_keymap": "JetBrains",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 16.0,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": null
    }
  }
}
