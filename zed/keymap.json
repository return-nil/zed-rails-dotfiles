// Zed keymap
// https://zed.dev/docs/key-bindings
[
  {
    "context": "Workspace",
    "bindings": {
      // Add workspace keybindings here.
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // Example: "j k": "vim::NormalBefore"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "alt-cmd-p": [
        "task::Spawn",
        { "task_name": "Open PR for current line" }
      ],
      // JetBrains base keymap が単独 cmd-k を git panel に割り当てるため ⌘K P (CopyPath) は届かない
      "cmd-shift-c": "editor::CopyPath",
      "cmd-alt-shift-c": "editor::CopyRelativePath"
    }
  },
  {
    "bindings": {
      "cmd-n": "workspace::NewFile",
      "cmd-d": "pane::SplitRight",
      "cmd-shift-d": "pane::SplitDown",
      "cmd-alt-left": "workspace::ActivatePaneLeft",
      "cmd-alt-right": "workspace::ActivatePaneRight",
      "cmd-alt-up": "workspace::ActivatePaneUp",
      "cmd-alt-down": "workspace::ActivatePaneDown"
    }
  },
  {
    "bindings": {
      "alt-cmd-y": "editor::OpenPermalinkToLine"
    }
  }
]
