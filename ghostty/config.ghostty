# Ghostty settings for Zed + Herdr

font-size = 14

window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
window-save-state = always

mouse-hide-while-typing = true
cursor-style-blink = false

# Use the left Option key as Alt while keeping the right Option key for macOS symbols.
macos-option-as-alt = left

# Subtle transparency.
background-opacity = 0.96
background-blur = 20

# Ghostty 既定の bright black (#666666) は背景 #282c34 に対し 2.4:1 しかなく、
# 二次情報を色 8 で描く TUI (Claude Code の dark-ansi 等) が読めない。
palette = 8=#a8a8a8
